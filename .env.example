VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_LLM_MODEL=claude-sonnet-4-5-20250514
VITE_EMBED_MODEL=
VITE_EMBED_DIM=1536
VITE_RETRIEVAL_TOP_K=8
VITE_RETRIEVAL_MIN_SCORE=0.75
VITE_CONSTRAINT_CATEGORIES=compliance,brand,guidelines
VITE_GENERATION_REQUIRED_CATEGORIES=brand
VITE_GROUNDING_UNSUPPORTED_POLICY=soft_block
VITE_CHUNK_TARGET_TOKENS=600
VITE_CHUNK_OVERLAP_PCT=15

# ---------------------------------------------------------------------------
# Server-side only (Vercel Environment Variables — NEVER prefixed with VITE_,
# never exposed to the browser). Set these in the Vercel dashboard.
# ---------------------------------------------------------------------------
# OPENROUTER_API_KEY=            # Required for all AI features
# LLM_MODEL=anthropic/claude-sonnet-4-5

# Ideas Lab + Trend Supervisor live signals (optional but recommended)
# TAVILY_API_KEY=               # Live news/web search for the trend scanner

# Scheduled (cron) trend scans — required only for the daily automated scan.
# Manual scans from the app work without these.
# SUPABASE_URL=                 # Same project URL as VITE_SUPABASE_URL
# SUPABASE_SERVICE_ROLE_KEY=    # Service role key (server-only, bypasses RLS)
# CRON_SECRET=                  # Any random string; Vercel Cron sends it as a Bearer token
