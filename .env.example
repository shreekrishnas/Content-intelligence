VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_LLM_MODEL=claude-sonnet-4-5-20250514
VITE_EMBED_MODEL=openai/text-embedding-3-small
VITE_EMBED_DIM=1024
VITE_RETRIEVAL_TOP_K=8
VITE_RETRIEVAL_MIN_SIMILARITY=0.25
VITE_CONSTRAINT_CATEGORIES=compliance,brand,guidelines
VITE_GENERATION_REQUIRED_CATEGORIES=brand
VITE_GROUNDING_UNSUPPORTED_POLICY=soft_block
VITE_CHUNK_TARGET_TOKENS=600
VITE_CHUNK_OVERLAP_PCT=15

# ---------------------------------------------------------------------------
# Server-side only (Vercel Environment Variables — NEVER prefixed with VITE_,
# never exposed to the browser). Set these in the Vercel dashboard.
# ---------------------------------------------------------------------------
# OPENROUTER_API_KEY=            # Required for all AI features
# LLM_MODEL=anthropic/claude-sonnet-4-5

# Semantic retrieval (pgvector). Pick ONE embedding provider — both produce
# 1024-dim vectors. Without either, the client falls back to keyword scoring
# (nothing breaks, retrieval is just less semantic).
# VOYAGE_API_KEY=                # Optional — 200M tokens free forever
# OPENAI_API_KEY=                # Optional — text-embedding-3-small with dimensions:1024
# EMBED_PROVIDER=openrouter      # Set to 'openrouter' to use OPENROUTER_API_KEY for embeddings (openai/text-embedding-3-small)

# Ideas Lab + Trend Supervisor live signals (optional but recommended)
# TAVILY_API_KEY=               # Live news/web search for the trend scanner

# Server DB access (used by extract-knowledge for chunk embeddings, by
# backfill-embeddings, and by the daily trend cron).
# SUPABASE_URL=                 # Same project URL as VITE_SUPABASE_URL
# SUPABASE_ANON_KEY=            # Same anon key — used to verify caller identity
# SUPABASE_SERVICE_ROLE_KEY=    # Service role key (server-only, bypasses RLS)
# CRON_SECRET=                  # Any random string; Vercel Cron sends it as a Bearer token
# SITE_URL=                     # Production URL (e.g. https://app.example.com) — locks CORS to this origin
# ALLOWED_EMAIL_DOMAIN=trilliantdigital.com  # Only emails from this domain can use the API
